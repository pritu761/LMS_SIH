# CAPACITY CONNECT - Environment Configuration Template

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL / Neon DB)
# ==========================================
DATABASE_URL="postgresql://<user>:<password>@<neon-pooler-host>/capacity_connect?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://<user>:<password>@<neon-host>/capacity_connect?sslmode=require"

# ==========================================
# AUTHENTICATION & JWT SECURITY
# ==========================================
JWT_SECRET="capacity-connect-super-secure-jwt-secret-key-2026-production"
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# FILE & MEDIA STORAGE (Zero-Cost Local Mode)
# ==========================================
# Default: "local" (Stores media in public/uploads/ without any cloud fees)
# Optional Future: "s3"
STORAGE_PROVIDER="local"

# Node Environment
NODE_ENV="development"

# ==========================================
# CARTO MAPS & GIS (Free for Students / Education)
# ==========================================
# Optional: Enter your CARTO API Key for student/pro basemaps (Dark Matter, Positron, Voyager)
NEXT_PUBLIC_CARTO_API_KEY=""
