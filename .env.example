# CAPACITY CONNECT - Environment Configuration Template

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL / Neon DB)
# ==========================================
DATABASE_URL="postgresql://<user>:<password>@<neon-pooler-host>/capacity_connect?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://<user>:<password>@<neon-host>/capacity_connect?sslmode=require"

# ==========================================
# AUTHENTICATION & JWT SECURITY
# ==========================================
JWT_SECRET="capacity-connect-super-secure-jwt-secret-key-2026-production"
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# FILE & MEDIA STORAGE (Zero-Cost Local Mode)
# ==========================================
# Default: "local" (Stores media in public/uploads/ without any cloud fees)
# Optional Future: "s3"
STORAGE_PROVIDER="local"

# Node Environment
NODE_ENV="development"

# ==========================================
# CARTO MAPS & GIS (Free for Students / Education)
# ==========================================
# Optional: Enter your CARTO API Key for student/pro basemaps (Dark Matter, Positron, Voyager)
NEXT_PUBLIC_CARTO_API_KEY=""

# ==========================================
# GROQ AI (Free-tier LLM for MausamBot)
# ==========================================
# Get a FREE key at https://console.groq.com (no credit card).
# Enables the AI chatbot's open-ended answers via openai/gpt-oss-120b
# (fallback: openai/gpt-oss-20b). Without it, the bot uses the built-in
# rule engine only. Server-side only — never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=""

# ==========================================
# SUPER-ADMIN PIN (Matcher policy guard)
# ==========================================
# Required to run the 55/30/15 matcher with out-of-policy weights.
# Server-side only. Without it (non-production), dev fallback PIN 000000
# applies; in production, out-of-policy runs are blocked until this is set.
SUPER_ADMIN_PIN=""

# ==========================================
# OBSERVABILITY, RATE LIMITS & COMMS
# ==========================================
# Optional Sentry DSN (server). Client counterpart: NEXT_PUBLIC_SENTRY_DSN.
# Without a DSN, errors log as structured JSON only.
SENTRY_DSN=""
# Slow-query threshold in ms for DB performance warnings.
SLOW_QUERY_MS="200"
# Login abuse control: attempts per window (ms) per IP.
RATE_LIMIT_AUTH_ATTEMPTS="5"
RATE_LIMIT_AUTH_WINDOW_MS="900000"
# Bulk validation jobs per hour per admin.
RATE_LIMIT_BULK_JOBS="3"
RATE_LIMIT_BULK_WINDOW_MS="3600000"
# Assistant cap is ASSISTANT_RATE_LIMIT_PER_HOUR (default 20).
# Cron shared secret for /api/cron/* (Vercel Cron sends it as Bearer).
CRON_SECRET=""
# Transactional email via Resend (optional; in-app notices always work).
RESEND_API_KEY=""
RESEND_FROM="CapacityConnect <onboarding@resend.dev>"
